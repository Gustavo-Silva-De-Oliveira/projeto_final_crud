# Copie este arquivo para ".env" e ajuste os valores.
# O arquivo ".env" NÃO deve ser commitado (já está no .gitignore).

# Chave usada para assinar a sessão. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria

# Opcional. Padrão: SQLite local em instance/sgc.db
# DATABASE_URL=sqlite:///sgc.db
